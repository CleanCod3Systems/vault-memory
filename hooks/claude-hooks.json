{
  "description": "vault-memory: automatic vault recall, a gate before external searches, a daily summary at the first session of the day, read tracking, context after compaction and a memory prompt at the end of the session",
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/recall.py"], "timeout": 10}]}
    ],
    "PreToolUse": [
      {"matcher": "^(mcp__.*|WebFetch|WebSearch)$", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"], "timeout": 5}]}
    ],
    "PostToolUse": [
      {"matcher": "Read", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/read.py"], "timeout": 5}]}
    ],
    "SessionStart": [
      {"matcher": "startup", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/today.py"], "timeout": 5}]},
      {"matcher": "compact", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/compact.py"], "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop.py"], "timeout": 10}]}
    ]
  }
}
